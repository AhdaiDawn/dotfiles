[user]
	email = ahdai19970918@gmail.com
	name = ahdai

[credential]
	helper = libsecret

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    side-by-side = true

[merge]
    conflictStyle = zdiff3

[pull]
	rebase = true

[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[difftool]
	prompt = false

[commit]
	verbose = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rerere]
	enabled = true

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[gui]
	pruneduringfetch = true
[push]
	recurseSubmodules = check
	autoSetupRemote = true
