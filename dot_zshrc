unset LC_ALL
export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
export LC_MESSAGES=en_US.UTF-8

autoload -Uz compinit
_init_completion() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  local compdump="$cache_dir/zcompdump-$ZSH_VERSION"
  local -a stale_compdump

  mkdir -p "$cache_dir"
  stale_compdump=("$compdump"(N.mh+24))

  if [[ ! -f "$compdump" ]] || (( ${#stale_compdump} )); then
    compinit -d "$compdump" && touch -- "$compdump"
  else
    compinit -C -d "$compdump"
  fi
}
_init_completion
unfunction _init_completion

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=120000
SAVEHIST=100000

mkdir -p "${HISTFILE:h}"

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS

source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh

zmodload zsh/terminfo

_bind_history_substring_search() {
  local keymap="$1"

  bindkey -M "$keymap" '^[[A' history-substring-search-up
  bindkey -M "$keymap" '^[[B' history-substring-search-down
  [[ -n "${terminfo[kcuu1]}" ]] && bindkey -M "$keymap" "${terminfo[kcuu1]}" history-substring-search-up
  [[ -n "${terminfo[kcud1]}" ]] && bindkey -M "$keymap" "${terminfo[kcud1]}" history-substring-search-down
}

zvm_after_init() {
  if [[ -t 0 && -t 1 ]]; then
    source /usr/share/fzf/key-bindings.zsh
    source /usr/share/fzf/completion.zsh
  fi

  _bind_history_substring_search viins
}

zvm_after_lazy_keybindings() {
  _bind_history_substring_search vicmd
  bindkey -M vicmd 'k' history-substring-search-up
  bindkey -M vicmd 'j' history-substring-search-down
}

ZVM_INIT_MODE=sourcing
source /usr/share/zsh/plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

eval "$(zoxide init zsh)"

eval "$(starship init zsh)"

eval "$(direnv hook zsh)"

alias ..='cd ..'
alias ...='cd ../..'

alias l='eza'
alias la='eza -a'
alias ll='eza -al'

alias cls='clear'

alias lg='lazygit'
alias dotfiles='chezmoi'
alias j='just'
alias claude-auto='claude --enable-auto-mode'

alias zz='zellij'
alias za='zellij attach'
alias zl='zellij list-sessions'
alias zk='zellij kill-all-sessions' # 快速清空后台
alias zw='zellij attach -c work'
alias zn='zellij attach -c $(basename "$PWD")'

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

set-proxy () {
  export ALL_PROXY="socks5://127.0.0.1:10808"
  export HTTP_PROXY="http://127.0.0.1:10809"
  export HTTPS_PROXY="$HTTP_PROXY"
  export WS_PROXY="$HTTP_PROXY"
  export WSS_PROXY="$HTTPS_PROXY"
  export all_proxy="$ALL_PROXY"
  export http_proxy="$HTTP_PROXY"
  export https_proxy="$HTTPS_PROXY"
  export ws_proxy="$HTTP_PROXY"
  export wss_proxy="$HTTPS_PROXY"
}

reset-proxy () {
  unset ALL_PROXY
  unset HTTP_PROXY
  unset HTTPS_PROXY
  unset WS_PROXY
  unset WSS_PROXY
  unset all_proxy
  unset http_proxy
  unset https_proxy
  unset ws_proxy
  unset wss_proxy
}

source /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
