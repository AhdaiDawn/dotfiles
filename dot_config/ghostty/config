# Noctalia owns the color palette in ~/.config/ghostty/themes/noctalia.
# Keep this file limited to terminal behavior so palette changes take effect.
theme = noctalia

font-family = "Fira Code Nerd Font"
font-size = 12

# Window and cursor behavior.
window-padding-x = 14
window-padding-y = 14
resize-overlay = never
cursor-style = block
cursor-style-blink = false

# Keep the configured cursor shape while forwarding the terminfo environment
# through SSH sessions.
shell-integration-features = no-cursor,ssh-env

# Consistent copy/paste keys and distinguishable Shift+Enter for terminal apps.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u

# Keep terminal commands in English while Ghostty itself follows the Chinese
# graphical-session locale.
env = LANG=en_US.UTF-8
env = LANGUAGE=en_US:en
env = LC_ALL=en_US.UTF-8
