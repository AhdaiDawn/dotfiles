[accessibility]
ui_scale = {{ if eq .chezmoi.hostname .devices.companyHostname }}1.0{{ else }}1.25{{ end }}

[backdrop]
tint_intensity = 0.29999999329447746

[bar.default]
background_opacity = 0.79999998211860657
center = [ "clock", "notifications" ]
end = [
    "media",
    "tray",
    "clipboard",
    "network",
    "bluetooth",
    "volume",
    "brightness",
{{- if ne .chezmoi.hostname .devices.companyHostname }}
    "battery",
{{- end }}
    "control-center",
    "session",
]
margin_ends = 0

[brightness]
enable_ddcutil = true

[brightness.monitor.HDMI-A-1]
backend = "ddcutil"

{{- if eq .chezmoi.hostname .devices.companyHostname }}

[brightness.monitor.DP-2]
backend = "ddcutil"
{{- end }}

[control_center]

[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "bluetooth"

[[control_center.shortcuts]]
type = "ahdai/sleep-inhibit:toggle"

[[control_center.shortcuts]]
type = "nightlight"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "power_profile"

[desktop_widgets]
enabled = false

[idle]
behavior_order = [ "lock", "screen-off", "suspend" ]
pre_action_fade_seconds = 2.0

[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 300

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
timeout = 360

[idle.behavior.suspend]
action = "lock_and_suspend"
enabled = {{ if eq .chezmoi.hostname .devices.companyHostname }}false{{ else }}true{{ end }}
timeout = 1800

[location]
auto_locate = true

[lockscreen_widgets]
enabled = false

[plugins]
auto_update = "none"
enabled = [ "ahdai/sleep-inhibit" ]

[[plugins.source]]
name = "official"
kind = "git"
location = "https://github.com/noctalia-dev/official-plugins"
enabled = false

[[plugins.source]]
name = "community"
kind = "git"
location = "https://github.com/noctalia-dev/community-plugins"
enabled = false

[shell]
polkit_agent = true
setup_wizard_enabled = false

[shell.screenshot]
copy_to_clipboard = true
directory = "~/Pictures/Screenshots"
filename_pattern = "Screenshot from %Y-%m-%d %H-%M-%S"
freeze_screen = true
save_to_file = true

[theme]
builtin = "Gruvbox"
mode = "dark"
source = "builtin"

[theme.templates]
builtin_ids = [ "ghostty", "gtk3", "gtk4", "starship" ]

# Keep the niri switcher policy alongside Noctalia's generated palette. The
# built-in niri template cannot carry local recent-windows bindings.
[theme.templates.user.niri_scoped_switcher]
input_path = "$XDG_CONFIG_HOME/noctalia/templates/niri.kdl"
output_path = "$XDG_CONFIG_HOME/niri/noctalia.kdl"

[wallpaper.default]
path = "/usr/share/noctalia/assets/noctalia-wallpaper.png"
