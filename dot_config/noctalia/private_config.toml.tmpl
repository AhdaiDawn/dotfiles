{{- $device := includeTemplate ".chezmoitemplates/device-profile" . | trim -}}
[accessibility]
ui_scale = {{ if eq $device "company-pc" }}1.0{{ else }}1.25{{ end }}

[backdrop]
# niri 26.04+ blurs the actual content behind Noctalia through
# ext-background-effect-v1. Disable Noctalia's older pre-blurred wallpaper
# backdrop so it cannot masquerade as compositor blur.
enabled = false

[bar.default]
background_opacity = 0.72
concave_edge_corners = false
center = [ "clock", "notifications" ]
end = [
    "media",
    "tray",
    "clipboard",
    "network",
    "bluetooth",
    "recorder",
    "volume",
    "brightness",
{{- if eq $device "home-laptop" }}
    "battery",
{{- end }}
    "control-center",
    "session",
]
margin_ends = 0

[brightness]
enable_ddcutil = true

[brightness.monitor.HDMI-A-1]
backend = "ddcutil"

{{- if eq $device "company-pc" }}

[brightness.monitor.DP-2]
backend = "ddcutil"
{{- end }}

[control_center.calendar]
show_events_card = false

[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "ahdai/sleep-inhibit:toggle"

[[control_center.shortcuts]]
type = "nightlight"

[[control_center.shortcuts]]
type = "power_profile"

[desktop_widgets]
enabled = false

[idle]
behavior_order = [ "lock", "screen-off", "suspend" ]
pre_action_fade_seconds = 2.0

[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 300

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
timeout = 360

[idle.behavior.suspend]
action = "lock_and_suspend"
enabled = {{ if eq $device "company-pc" }}false{{ else }}true{{ end }}
timeout = 1800

[location]
auto_locate = false
address = "Hangzhou, Zhejiang, China"

[notification]
background_opacity = 0.84

[osd]
background_opacity = 0.84

[lockscreen_widgets]
enabled = false

[plugins]
auto_update = "none"
enabled = [ "ahdai/sleep-inhibit", "noctalia/screen_recorder" ]

[[plugins.source]]
name = "official"
kind = "git"
location = "https://github.com/noctalia-dev/official-plugins"
enabled = true

[shell]
clipboard_image_action_command = "~/.local/bin/ocr-image"
polkit_agent = true
setup_wizard_enabled = false

[shell.panel]
transparency_mode = "glass"

[shell.screenshot]
copy_to_clipboard = true
directory = {{ includeTemplate ".chezmoitemplates/screenshot-directory" . | quote }}
filename_pattern = "Screenshot from %Y-%m-%d %H-%M-%S"
freeze_screen = true
save_to_file = true

[theme]
builtin = "Gruvbox"
mode = "dark"
source = "builtin"

[theme.templates]
builtin_ids = [ "ghostty", "gtk3", "gtk4", "niri", "qt", "scroll", "starship" ]
community_ids = [ "fcitx5", "yazi" ]

[wallpaper.default]
path = "/usr/share/noctalia/assets/noctalia-wallpaper.png"

[widget.recorder]
type = "noctalia/screen_recorder:recorder"
