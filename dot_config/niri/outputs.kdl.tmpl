{{- $device := includeTemplate ".chezmoitemplates/device-profile" . | trim -}}
{{ if eq $device "company-pc" -}}
// Company PC: Lenovo on the left, Huawei on the right.
// Pin the non-preferred 75 Hz Lenovo mode instead of falling back to 60 Hz.
output "HDMI-A-1" {
    mode "1920x1080@74.986"
    scale 1.2
    position x=0 y=0
}

output "DP-2" {
    mode "1920x1080@74.973"
    scale 1.2
    position x=1600 y=0
    focus-at-startup
}
{{ else -}}
// Home laptop: the output autoswitch service keeps the panel on unless the
// external display is physically connected and active in niri.
output "HDMI-A-1" {
    mode "3840x2160@160.001"
    scale 1.7
    position x=0 y=0
    focus-at-startup
}

// Use 60 Hz for lower power consumption when away from the dock.
output "eDP-1" {
    mode "2560x1600@60.008"
    scale 1.5
    transform "normal"

    layout {
        default-column-width { proportion 1.0; }

        preset-column-widths {
            proportion 0.5
            proportion 0.66667
            proportion 1.0
        }
    }
}

{{ end -}}
