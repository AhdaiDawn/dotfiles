{{- $device := includeTemplate ".chezmoitemplates/device-profile" . | trim -}}
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications and Noctalia surfaces.
    Mod+T hotkey-overlay-title="Open a Terminal: Ghostty" { spawn "ghostty"; }
    Mod+E hotkey-overlay-title="Open Files: Nautilus" { spawn "nautilus" "--new-window"; }
    Mod+Space hotkey-overlay-title="Open Noctalia Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Alt+Space hotkey-overlay-title="Open Noctalia Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Open Noctalia Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma hotkey-overlay-title="Open Noctalia Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    // Alt+Tab is handled by niri's recent-windows block in switcher.kdl.
    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "noctalia" "msg" "session" "lock"; }

    // Window focus and movement.
    Mod+W repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // Monitor focus and movement.
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Tab { focus-workspace-previous; }

    // The normal wheel follows niri's horizontal column axis, with vertical scrolling reversed.
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp { move-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }

    // Shift changes the wheel to the vertical workspace axis.
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Column composition, sizing and display mode.
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+F { maximize-column; }
    Mod+G hotkey-overlay-title="Toggle Window Floating" { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+V repeat=false hotkey-overlay-title="Open Noctalia Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+B hotkey-overlay-title="Toggle Column Tabbed Display" { toggle-column-tabbed-display; }

    // Open saved screenshots in Satty. Enter saves annotations, copies the
    // result to the clipboard, and closes Satty.
    Print repeat=false hotkey-overlay-title="Take Region Screenshot" { spawn "niri-screenshot" "region"; }
    Ctrl+Print repeat=false hotkey-overlay-title="Take Display Screenshot" { spawn "niri-screenshot" "screen"; }
    Shift+Print repeat=false hotkey-overlay-title="Take All Displays Screenshot" { spawn "niri-screenshot" "all"; }
    Alt+Print repeat=false hotkey-overlay-title="Take Window Screenshot" { spawn "niri-screenshot" "window"; }

{{- if eq $device "home-laptop" }}

    // Toggle the laptop panel, but never turn off the last active display.
    Mod+Shift+D hotkey-overlay-title="Toggle Laptop Display" { spawn "niri-output-autoswitch" "--toggle"; }
{{- end }}

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}
