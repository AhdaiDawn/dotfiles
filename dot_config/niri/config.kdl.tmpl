// Core niri configuration. Window rules and key bindings are split into includes.

input {
    keyboard {
        xkb {}
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {}
    trackpoint {}

    // Follow the pointer across windows and outputs without scrolling hidden
    // columns into view merely because the pointer crossed their edge.
    focus-follows-mouse max-scroll-amount="0%"
}

// Display names and geometry differ between machines.
include "outputs.kdl"

layout {
    gaps 16
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }
}

// Noctalia v5 requests exact rounded blur regions through
// ext-background-effect-v1. These compositor-side settings control the real
// content blur rendered inside those regions.
blur {
    passes 4
    offset 3.0
    noise 0.02
    saturation 1.2
}

spawn-at-startup "noctalia"
// Fcitx renders XWayland candidate windows from Xft.dpi. Load a value derived
// from niri's active output scale before Fcitx opens its X11 connection.
spawn-at-startup "sh" "-c" "$HOME/.local/bin/refresh-xwayland-dpi; exec fcitx5 -d"

screenshot-path {{ printf "%s/Screenshot from %%Y-%%m-%%d %%H-%%M-%%S.png" (includeTemplate ".chezmoitemplates/screenshot-directory" .) | quote }}

// Allow common tray applications to activate their window after an explicit click.
debug {
    honor-xdg-activation-with-invalid-serial
}

include "rules.kdl"
include "binds.kdl"
include "switcher.kdl"

// Noctalia regenerates this palette fragment when the color scheme changes.
include "noctalia.kdl"
