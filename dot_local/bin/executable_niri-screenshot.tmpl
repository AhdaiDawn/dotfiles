#!/usr/bin/env bash

set -euo pipefail

mode=${1:-region}

if [[ -n ${NIRI_SCREENSHOT_TIMEOUT_SECONDS:-} ]]; then
    screenshot_timeout_seconds=$NIRI_SCREENSHOT_TIMEOUT_SECONDS
else
    screenshot_timeout_seconds=3
fi

notify_failure() {
    local message=$1

    printf 'niri-screenshot: %s\n' "$message" >&2

    if command -v noctalia >/dev/null 2>&1 &&
        noctalia msg notification-show "Screenshot failed" "$message" >/dev/null 2>&1; then
        return
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Screenshot failed" "$message" >/dev/null 2>&1 || true
    fi
}

case $screenshot_timeout_seconds in
    '' | *[!0-9]* | 0)
        printf 'niri-screenshot: NIRI_SCREENSHOT_TIMEOUT_SECONDS must be a positive integer\n' >&2
        exit 2
        ;;
esac

case $mode in
    region | screen | window | all) ;;
    *)
        printf 'Usage: %s {region|screen|all|window}\n' "${0##*/}" >&2
        exit 2
        ;;
esac

for dependency in niri satty jq wl-copy; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        notify_failure "Missing command: $dependency"
        exit 127
    fi
done

if [[ $mode == all || $mode == region ]] && ! command -v grim >/dev/null 2>&1; then
    notify_failure "Missing command: grim"
    exit 127
fi

if [[ $mode == region ]] && ! command -v slurp >/dev/null 2>&1; then
    notify_failure "Missing command: slurp"
    exit 127
fi

# Keep the directory aligned with niri and Noctalia at chezmoi apply time.
screenshot_dir='{{ includeTemplate ".chezmoitemplates/screenshot-directory" . | replace "'" "'\\''" }}'
mkdir -p "$screenshot_dir"

next_screenshot_path() {
    local timestamp base path suffix

    timestamp=$(date '+%Y-%m-%d %H-%M-%S')
    base=$screenshot_dir/Screenshot\ from\ $timestamp
    path=$base.png
    suffix=2

    while [[ -e $path ]]; do
        path="$base ($suffix).png"
        ((suffix++))
    done

    printf '%s\n' "$path"
}

wait_for_file() {
    local path=$1 deadline

    # Non-interactive niri captures return before the file has been written.
    deadline=$((SECONDS + screenshot_timeout_seconds))
    while ((SECONDS < deadline)); do
        if [[ -s $path ]]; then
            sleep 0.05
            [[ -s $path ]] && return 0
        fi
        sleep 0.1
    done

    return 1
}

open_screenshot() {
    local path=$1 window_json window_id

    # Enter saves the annotated image back to the screenshot, copies the same
    # rendered image to the Wayland clipboard, and closes Satty.
    satty \
        --filename "$path" \
        --output-filename "$path" \
        --copy-command wl-copy \
        --actions-on-enter=save-to-file,save-to-clipboard,exit \
        --app-id com.gabm.satty \
        >/dev/null 2>&1 &

    # The window rule makes Satty float. Center the focused Satty window once
    # the compositor has registered it.
    for ((attempt = 0; attempt < 100; attempt++)); do
        window_json=$(niri msg --json focused-window 2>/dev/null || true)
        if [[ -n $window_json ]] &&
            [[ $(jq -r '.app_id // empty' <<<"$window_json") == com.gabm.satty ]]; then
            window_id=$(jq -r '.id // empty' <<<"$window_json")
            if [[ -n $window_id ]]; then
                niri msg action center-window --id "$window_id" >/dev/null
                return 0
            fi
        fi
        sleep 0.05
    done
}

case $mode in
    region)
        # slurp waits for a selection without a timeout and exits on cancellation.
        # Capture only after selection completes, so Esc leaves no screenshot.
        selection_error=$(mktemp)
        trap 'rm -f -- "$selection_error"' EXIT
        if geometry=$(LC_ALL=C slurp 2>"$selection_error"); then
            screenshot_path=$(next_screenshot_path)
        else
            selection_status=$?
            # slurp also uses exit status 1 for display/connection errors.
            if ((selection_status == 1)) &&
                [[ $(<"$selection_error") == *"selection cancelled" ]]; then
                exit 0
            fi
            cat -- "$selection_error" >&2
            notify_failure "Could not select a screenshot region"
            exit "$selection_status"
        fi

        if ! grim -g "$geometry" "$screenshot_path"; then
            notify_failure "Could not capture the selected region"
            exit 1
        fi
        open_screenshot "$screenshot_path"
        ;;
    screen | window)
        screenshot_path=$(next_screenshot_path)

        case $mode in
            screen) niri_action=screenshot-screen ;;
            window) niri_action=screenshot-window ;;
        esac

        if ! niri msg action "$niri_action" --path "$screenshot_path" >/dev/null; then
            notify_failure "Could not start the screenshot action"
            exit 1
        fi

        if ! wait_for_file "$screenshot_path"; then
            notify_failure "Timed out after ${screenshot_timeout_seconds}s waiting for the screenshot"
            exit 1
        fi

        open_screenshot "$screenshot_path"
        ;;
    all)
        screenshot_path=$(next_screenshot_path)
        if ! grim "$screenshot_path"; then
            notify_failure "Could not capture all displays"
            exit 1
        fi
        open_screenshot "$screenshot_path"
        ;;
esac
