#!/usr/bin/env bash

set -euo pipefail

mode=${1:-region}
screenshot_timeout_seconds=${NIRI_SCREENSHOT_TIMEOUT_SECONDS:-30}

notify_failure() {
    local message=$1

    printf 'niri-screenshot: %s\n' "$message" >&2

    if command -v noctalia >/dev/null 2>&1 &&
        noctalia msg notification-show "Screenshot failed" "$message" >/dev/null 2>&1; then
        return
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Screenshot failed" "$message" >/dev/null 2>&1 || true
    fi
}

case $screenshot_timeout_seconds in
    '' | *[!0-9]* | 0)
        printf 'niri-screenshot: NIRI_SCREENSHOT_TIMEOUT_SECONDS must be a positive integer\n' >&2
        exit 2
        ;;
esac

case $mode in
    region | screen | window | all) ;;
    *)
        printf 'Usage: %s {region|screen|all|window}\n' "${0##*/}" >&2
        exit 2
        ;;
esac

for dependency in niri satty jq wl-copy; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        notify_failure "Missing command: $dependency"
        exit 127
    fi
done

if [[ $mode == all ]] && ! command -v noctalia >/dev/null 2>&1; then
    notify_failure "Missing command: noctalia"
    exit 127
fi

pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
if [[ -z $pictures_dir || $pictures_dir != /* ]]; then
    pictures_dir=$HOME/Pictures
fi

screenshot_dir=$pictures_dir/Screenshots
mkdir -p "$screenshot_dir"

next_screenshot_path() {
    local timestamp base path suffix

    timestamp=$(date '+%Y-%m-%d %H-%M-%S')
    base=$screenshot_dir/Screenshot\ from\ $timestamp
    path=$base.png
    suffix=2

    while [[ -e $path ]]; do
        path="$base ($suffix).png"
        ((suffix++))
    done

    printf '%s\n' "$path"
}

wait_for_file() {
    local path=$1 deadline

    # Interactive screenshots return control before the selection is finished.
    deadline=$((SECONDS + screenshot_timeout_seconds))
    while ((SECONDS < deadline)); do
        if [[ -s $path ]]; then
            sleep 0.05
            [[ -s $path ]] && return 0
        fi
        sleep 0.1
    done

    return 1
}

open_screenshot() {
    local path=$1 window_json window_id

    # Enter saves the annotated image back to the screenshot, copies the same
    # rendered image to the Wayland clipboard, and closes Satty.
    satty \
        --filename "$path" \
        --output-filename "$path" \
        --copy-command wl-copy \
        --actions-on-enter=save-to-file,save-to-clipboard,exit \
        --app-id com.gabm.satty \
        >/dev/null 2>&1 &

    # The window rule makes Satty float. Center the focused Satty window once
    # the compositor has registered it.
    for ((attempt = 0; attempt < 100; attempt++)); do
        window_json=$(niri msg --json focused-window 2>/dev/null || true)
        if [[ -n $window_json ]] &&
            [[ $(jq -r '.app_id // empty' <<<"$window_json") == com.gabm.satty ]]; then
            window_id=$(jq -r '.id // empty' <<<"$window_json")
            if [[ -n $window_id ]]; then
                niri msg action move-window-to-floating --id "$window_id" >/dev/null
                niri msg action center-window --id "$window_id" >/dev/null
                return 0
            fi
        fi
        sleep 0.05
    done
}

case $mode in
    region | screen | window)
        screenshot_path=$(next_screenshot_path)
        niri_action=screenshot

        case $mode in
            screen) niri_action=screenshot-screen ;;
            window) niri_action=screenshot-window ;;
        esac

        if ! niri msg action "$niri_action" --path "$screenshot_path" >/dev/null; then
            notify_failure "Could not start the screenshot action"
            exit 1
        fi

        if ! wait_for_file "$screenshot_path"; then
            notify_failure "Timed out after ${screenshot_timeout_seconds}s waiting for the screenshot"
            exit 1
        fi

        open_screenshot "$screenshot_path"
        ;;
    all)
        # niri has no direct all-output action. Keep Noctalia for this mode and
        # identify the file it creates after this invocation.
        marker=$(mktemp --tmpdir niri-screenshot.XXXXXX)
        trap 'rm -f "$marker"' EXIT

        if ! noctalia msg screenshot-fullscreen all >/dev/null; then
            notify_failure "Could not start the all-display screenshot"
            exit 1
        fi

        screenshot_path=
        deadline=$((SECONDS + screenshot_timeout_seconds))
        while ((SECONDS < deadline)); do
            screenshot_path=$(
                find "$screenshot_dir" -maxdepth 1 -type f -name '*.png' \
                    -newer "$marker" -printf '%T@ %p\n' 2>/dev/null |
                    sort -nr |
                    sed -n '1s/^[^ ]* //p'
            )
            if [[ -n $screenshot_path && -s $screenshot_path ]]; then
                sleep 0.05
                open_screenshot "$screenshot_path"
                break
            fi
            sleep 0.1
        done

        if [[ -z $screenshot_path || ! -s $screenshot_path ]]; then
            notify_failure "Timed out after ${screenshot_timeout_seconds}s waiting for the all-display screenshot"
            exit 1
        fi
        ;;
esac
