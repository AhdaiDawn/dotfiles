#!/usr/bin/env bash

set -euo pipefail

internal_output=${NIRI_INTERNAL_OUTPUT:-eDP-1}
external_output=${NIRI_EXTERNAL_OUTPUT:-HDMI-A-1}
drm_class_dir=${NIRI_DRM_CLASS_DIR:-/sys/class/drm}
settle_delay=${NIRI_OUTPUT_SETTLE_DELAY:-0.5}

usage() {
    printf 'Usage: %s [--once|--toggle]\n' "${0##*/}"
}

case $# in
    0) action=monitor ;;
    1)
        case $1 in
            --once) action=once ;;
            --toggle) action=toggle ;;
            -h | --help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

for dependency in jq niri udevadm; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'niri-output-autoswitch: missing command: %s\n' "$dependency" >&2
        exit 127
    fi
done

external_connector_is_connected() {
    local status status_path
    local -a status_paths

    shopt -s nullglob
    status_paths=("$drm_class_dir"/card*-"$external_output"/status)
    shopt -u nullglob

    for status_path in "${status_paths[@]}"; do
        if IFS= read -r status <"$status_path" && [[ $status == connected ]]; then
            return 0
        fi
    done

    return 1
}

external_output_is_active() {
    local attempt outputs

    # Connector discovery and mode activation can arrive as separate events.
    # Wait briefly, but never turn off the internal panel unless niri confirms
    # that the external output has an active mode.
    for ((attempt = 0; attempt < 20; attempt++)); do
        if outputs=$(niri msg --json outputs 2>/dev/null) &&
            jq -e --arg output "$external_output" \
                '.[$output].current_mode != null' <<<"$outputs" >/dev/null; then
            return 0
        fi
        sleep 0.25
    done

    return 1
}

internal_output_is_active() {
    local outputs

    outputs=$(niri msg --json outputs 2>/dev/null) &&
        jq -e --arg output "$internal_output" \
            '.[$output].current_mode != null' <<<"$outputs" >/dev/null
}

set_internal_output() {
    local action=$1 attempt result

    for ((attempt = 0; attempt < 10; attempt++)); do
        if result=$(niri msg output "$internal_output" "$action" 2>&1); then
            printf 'niri-output-autoswitch: external=%s internal=%s\n' \
                "$external_output" "$action"
            return 0
        fi
        sleep 0.25
    done

    printf 'niri-output-autoswitch: could not turn %s %s: %s\n' \
        "$internal_output" "$action" "$result" >&2
    return 1
}

reconcile_outputs() {
    if external_connector_is_connected && external_output_is_active; then
        set_internal_output off
    else
        # Missing, disconnected, or inactive external output: keep a usable
        # display available even if connector discovery is still settling.
        set_internal_output on
    fi
}

toggle_internal_output() {
    if internal_output_is_active; then
        if external_connector_is_connected && external_output_is_active; then
            set_internal_output off
        else
            printf 'niri-output-autoswitch: keeping %s on; %s is not active\n' \
                "$internal_output" "$external_output"
        fi
    else
        set_internal_output on
    fi
}

case $action in
    once)
        reconcile_outputs
        exit 0
        ;;
    toggle)
        toggle_internal_output
        exit 0
        ;;
    monitor) reconcile_outputs ;;
esac

# udev separates events with an empty line. Reconcile once per DRM event after
# a short delay so niri has time to refresh its connector and mode state.
pending=false
udevadm monitor --udev --property --subsystem-match=drm |
    while IFS= read -r line; do
        case $line in
            ACTION=*) pending=true ;;
            '')
                if [[ $pending == true ]]; then
                    sleep "$settle_delay"
                    reconcile_outputs
                    pending=false
                fi
                ;;
        esac
    done
