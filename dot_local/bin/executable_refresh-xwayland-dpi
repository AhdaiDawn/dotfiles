#!/bin/sh

# XWayland exposes one global DPI even when niri uses fractional output
# scaling. Fcitx reads Xft.dpi when it renders an X11 candidate window.
scale=$(
    niri msg --json outputs 2>/dev/null |
        jq -r '[.[] | select(.logical != null) | .logical.scale] | min // 1' 2>/dev/null
)

case "$scale" in
    '' | *[!0-9.]* ) scale=1 ;;
esac

dpi=$(awk -v scale="$scale" 'BEGIN { printf "%d\n", scale * 96 + 0.5 }')
if [ "$dpi" -lt 96 ]; then
    dpi=96
fi

printf 'Xft.dpi:\t%s\n' "$dpi" | xrdb -merge
