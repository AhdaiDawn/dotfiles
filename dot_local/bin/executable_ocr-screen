#!/usr/bin/env bash

set -euo pipefail

notify() {
    local summary=$1 body=$2

    if command -v noctalia >/dev/null 2>&1 &&
        noctalia msg notification-show "$summary" "$body" >/dev/null 2>&1; then
        return
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$summary" "$body" >/dev/null 2>&1 || true
    fi
}

for dependency in grim slurp ocr-image; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        notify "OCR failed" "Missing command: $dependency"
        exit 127
    fi
done

if ! geometry=$(slurp); then
    exit 0
fi

image=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/ocr-screen-XXXXXX.png")
trap 'rm -f -- "$image"' EXIT

if ! grim -g "$geometry" "$image"; then
    notify "OCR failed" "Could not capture the selected region"
    exit 1
fi

ocr-image "$image"
