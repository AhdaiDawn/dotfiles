#!/usr/bin/env bash

set -euo pipefail

notify() {
    local summary=$1 body=$2

    if command -v noctalia >/dev/null 2>&1 &&
        noctalia msg notification-show "$summary" "$body" >/dev/null 2>&1; then
        return
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$summary" "$body" >/dev/null 2>&1 || true
    fi
}

for dependency in grim slurp ocr-image; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        notify "OCR failed" "Missing command: $dependency"
        exit 127
    fi
done

work_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/ocr-screen-XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT

if geometry=$(LC_ALL=C slurp 2>"$work_dir/selection-error"); then
    image=$work_dir/image.png
else
    selection_status=$?
    # slurp uses status 1 for both cancellation and display errors.
    if ((selection_status == 1)) &&
        [[ $(<"$work_dir/selection-error") == *"selection cancelled" ]]; then
        exit 0
    fi
    cat -- "$work_dir/selection-error" >&2
    notify "OCR failed" "Could not select a screen region"
    exit "$selection_status"
fi

if ! grim -g "$geometry" "$image"; then
    notify "OCR failed" "Could not capture the selected region"
    exit 1
fi

ocr-image "$image"
